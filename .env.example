# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Drizzle — provided by the Vercel-managed Neon integration (vercel env pull)
DATABASE_URL="postgresql://postgres:password@localhost:5432/Nexus"

# Vercel AI Gateway — one key for embeddings + generation.
# On Vercel this can authenticate via the OIDC token; set it locally to run
# ingestion (embeddings) and generation.
AI_GATEWAY_API_KEY=""

# Model routing (provider/model). Defaults live in src/env.js.
GEN_MODEL="zai/glm-5.3-flash"
EMBED_MODEL="openai/text-embedding-3-small"
CONTEXT_MODEL="zai/glm-5.3-flash"

# Reranking (Slice 2) — cross-encoder between RRF fusion and neighbor expansion.
# On by default since the 31-video measurement (+7.9pt precision, +7.0pt relevancy). Set
# RERANK_ENABLED=false to turn it off globally; the eval harness toggles it per-run regardless.
RERANK_MODEL="cohere/rerank-v3.5"
RERANK_ENABLED="true"

# Evals (Slice 2) — LLM judge for the golden-set scorers. Luna since Slice 3.3: GLM-flash swung
# answer-relevancy 69–85% on identical input; Luna holds within a point (~$0.15 per gate run).
EVAL_MODEL="openai/gpt-5.6-luna"

# STT fallback (Slice 3.2) — paid transcription for caption-less videos, direct to AssemblyAI
# (the AI Gateway does not route transcription). Off by default so a fresh checkout can never
# pay; flip it per run: TRANSCRIBE_FALLBACK=true pnpm ingest --channel @handle
ASSEMBLYAI_API_KEY=""
TRANSCRIBE_FALLBACK="false"

# Clerk (Slice 5) — auth for the web app. Optional at build/typecheck time (see src/env.js) so a
# fresh checkout builds without keys, but the authed web app cannot run without them. Provision an
# app with `npx clerk init` (writes real keys to .env.local) or copy them from dashboard.clerk.com.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
